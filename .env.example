# Google Cloud Project Configuration
GCP_PROJECT_ID=profitscout-fida8
GCP_REGION=us-central1

# BigQuery Configuration
BIGQUERY_DATASET=profit_scout
OPTIONS_SIGNALS_TABLE=options_analysis_signals
WINNERS_DASHBOARD_TABLE=winners_dashboard
DAILY_PREDICTIONS_TABLE=daily_predictions

# Google Cloud Storage Configuration
GCS_BUCKET_NAME=profit-scout-data

# Firestore Configuration (for Phase 2)
FIRESTORE_COLLECTION_USERS=taas_users
FIRESTORE_COLLECTION_USAGE=usage_logs

# Server Configuration
PORT=8080
LOG_LEVEL=INFO
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_CSE_ID=your_custom_search_engine_id_here

# Authentication (Phase 2)
REQUIRE_API_KEY=false  # Set to true in production

# OAuth 2.1 resource server (src/utils/oauth.py). Defaults are production;
# override only for local development against a local authorization server.
OAUTH_ENABLED=true
